# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text diff=csharp
*.csproj text
*.sln text
*.xaml text

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf

# Documentation
*.md text
*.txt text
README text
LICENSE text

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.dmg binary
*.app binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Other
*.pdf binary
